@startuml
object "af : CompagnieAerienne" as af {
  nom = "Air France"
}

object "paris : Ville" as paris {
  nom = "Paris"
}
object "cdg : Aeroport" as cdg {
  code = "CDG"
  nom = "Charles de Gaulle"
}
object "ory : Aeroport" as ory {
  code = "ORY"
  nom = "Orly"
}

object "toulouse : Ville" as toulouse {
  nom = "Toulouse"
}
object "tls : Aeroport" as tls {
  code = "TLS"
  nom = "Toulouse"
}

object "madrid : Ville" as madrid {
  nom = "Madrid"
}
object "mrd : Aeroport" as mrd {
  code = "MRD"
  nom = "Madrid"
}

object "marrakech : Ville" as marrakech {
  nom = "Marrakech"
}
object "mrk : Aeroport" as mrk {
  code = "MRK"
  nom = "Marrakech"
}

object "af04 : VolRegulier" as af04 {
  numero = "AF-04"
  jourSemaine = LUNDI
}
object "t_af04_1 : Troncon" as t1 {
  heureDepart = 06:30
  heureArrivee = 07:45
}

object "af33 : VolRegulier" as af33 {
  numero = "AF-33"
  jourSemaine = MARDI
}
object "t_af33_1 : Troncon" as t2 {
  heureDepart = 08:30
  heureArrivee = 11:00
}
object "t_af33_2 : Troncon" as t3 {
  heureDepart = 11:30
  heureArrivee = 15:45
}

paris -- cdg
paris -- ory
toulouse -- tls
madrid -- mrd
marrakech -- mrk

af -- af04 : opère >
af04 *-- t1
t1 --> tls : depart
t1 --> cdg : arrivee

af -- af33 : opère >
af33 *-- t2
af33 *-- t3
t2 --> cdg : depart
t2 --> mrd : arrivee
t3 --> mrd : depart
t3 --> mrk : arrivee

@enduml
